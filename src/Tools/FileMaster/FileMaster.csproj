<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WinToolBox.Tools.FileMaster</RootNamespace>
    <AssemblyName>FileMaster</AssemblyName>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 高 DPI：PerMonitorV2（由 ApplicationConfiguration.Initialize() 应用） -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 单文件发布参数（发布时使用） -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WinToolBox.Core\WinToolBox.Core.csproj" />
  </ItemGroup>

  <!-- 让测试项目能直接验证 internal 的 SafeDelete（P0-2 的非空保护是安全底线，必须直测） -->
  <ItemGroup>
    <InternalsVisibleTo Include="FileMaster.Tests" />
  </ItemGroup>

</Project>
